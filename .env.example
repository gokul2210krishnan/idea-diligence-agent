# =============================================================================
# Idea Diligence Agent — Environment Configuration
# =============================================================================

# --- Default Provider Configuration ---
# Options: "gemini" (recommended for zero-wait setup) or "bedrock"
DEFAULT_MODEL_PROVIDER=gemini
DEFAULT_MODEL_ID=gemini-2.5-flash

# --- Provider Credentials ---
# Required if using DEFAULT_MODEL_PROVIDER=gemini:
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required if using DEFAULT_MODEL_PROVIDER=bedrock:
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# DEFAULT_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# --- Optional Role-Specific Model Overrides ---
# You can route different roles to different models or providers:
# ORCHESTRATOR_MODEL_PROVIDER=gemini
# ORCHESTRATOR_MODEL_ID=gemini-2.5-flash
# PROBLEM_MODEL_PROVIDER=gemini
# PROBLEM_MODEL_ID=gemini-2.5-flash
# COMPETITION_MODEL_PROVIDER=gemini
# COMPETITION_MODEL_ID=gemini-2.5-flash
# ECONOMICS_MODEL_PROVIDER=gemini
# ECONOMICS_MODEL_ID=gemini-2.5-flash
